#pragma once

#include <string_view>

namespace MMM::UI::BuiltinToolPlugins
{
/// @brief 标准音频工具的 Lua 声明，构建配置阶段嵌入。
/// Lua 源码按构建输入保留换行和转义，视图借用静态字面量，无需运行期分配。
inline constexpr std::string_view AUDIO = R"mmm_audio(@MMM_TOOL_audio@)mmm_audio";
/// @brief 标准谱面工具的 Lua 声明，构建配置阶段嵌入。
/// 为各输入使用独立原始字符串分隔符，模板只替换选定的脚本占位符。
inline constexpr std::string_view BEATMAP = R"mmm_beatmap(@MMM_TOOL_beatmap@)mmm_beatmap";
}  // namespace MMM::UI::BuiltinToolPlugins
